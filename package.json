{
	"name": "obsidian-tincan",
	"version": "0.1.0",
	"private": true,
	"description": "Answer questions in Obsidian reading view",
	"license": "0BSD",
	"type": "module",
	"main": "main.js",
	"imports": {
		"#/src/*": "./src/*.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit && node esbuild.config.mjs production",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint --type-aware .",
		"release": "effect-obsidian release",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vitest.json --noEmit",
		"version": "effect-obsidian bump-manifest && git add manifest.json versions.json"
	},
	"dependencies": {
		"@tyler.earth/effect-obsidian": "0.1.3",
		"effect": "4.0.0-rc.113",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-frontmatter": "2.0.1",
		"micromark-extension-frontmatter": "2.0.0"
	},
	"devDependencies": {
		"@effect/language-service": "0.87.2",
		"@effect/vitest": "4.0.0-rc.113",
		"@oxlint/plugins": "1.82.0",
		"@types/mdast": "4.0.4",
		"@types/node": "24.9.2",
		"esbuild": "0.28.2",
		"happy-dom": "21.0.4",
		"obsidian": "1.13.1",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vitest": "5.0.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.8.0"
}
